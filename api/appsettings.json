{
  "ConnectionStrings": {
    "Default": "Data Source=/data/carinsurance.db"
  },
  "PolicyIssuance": {
    "TemplateVersion": "policy-v1.0"
  },
  "RenewalReminder": {
    "Enabled": true,
    "IntervalMinutes": 1440
  },
  "Jwt": {
    "Issuer": "CarInsurance.Api",
    "Audience": "CarInsurance.Web",
    "AccessTokenMinutes": 60,
    "MfaTokenMinutes": 5
  },
  "Auth": {
    "PasswordResetMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
